void smoothMove(Adafruit_PWMServoDriver &pca, int ch, int fromAngle, int toAngle, int totalTimeMs = 500) {
  int steps = 30; 
  unsigned long stepDelay = totalTimeMs / steps;

  for (int i = 0; i <= steps; i++) {
    float t = (float)i / (float)steps;
    float ease = 3*t*t - 2*t*t*t; // cubic easing

    int currentAngle = fromAngle + (toAngle - fromAngle) * ease;
    pca.setPWM(ch, 0, angleToPulse(currentAngle));
    delay(stepDelay);
  }
}

