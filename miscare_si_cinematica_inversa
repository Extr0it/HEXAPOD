  pca1.setPWM(ch, 0, angleToPulse(angle));
}

// -------------------- IK --------------------
void IK(float x, float y, float z, float* t1, float* t2, float* t3) {
  float pi = 3.14159;

  *t1 = atan2(z, x) * 180/pi + 90;

  float rx = sqrt(x*x + z*z) - L1;
  float fi2 = atan2(y, rx);
  float r   = sqrt(y*y + rx*rx);

  float fi1 = -acos((L2*L2 + r*r - L3*L3) / (2*L2*r));
  *t2 = (fi2 - fi1) * 180/pi;

  float fi3 = acos((-L2*L2 - L3*L3 + r*r) / (-2*L2*L3));
  *t3 = (pi - fi3) * 180/pi;
}

// --- MOVE LEG -
void gotoLeg(Leg &leg, float x, float y, float z) {
  float t1, t2, t3;
  IK(x, y, z, &t1, &t2, &t3);

  setServo(leg.coxa,  105 + (t1 - 90) + leg.offCoxa);
  setServo(leg.femur, 105 + t2       + leg.offFemur);
  setServo(leg.tibia, leg.neutralTibia + t3 + leg.offTibia);
}

// --- PATH ----
void legPath(Leg &leg, float phase) {
  float xStart = 100, xEnd = 130;  //(coordonatele pe care le parcurge, incepand de la x = 100 si se opreste la 130, inca trebuie adjustat, sa stiu cat de mult ma pot alungi de la stanga la dreapta
  float stepHeight = 40, zMax = 60; // inaltimea de arie a piciorului

  float t = phase;
  float x = xStart + (xEnd - xStart) * t;
  float z = zMax * (2*t - 1);
  float lift = stepHeight * sin(t * M_PI);
  float y = leg.yGround + lift;          // mecanism de miscare folosind niste smecherii(temporare)

  gotoLeg(leg, x, y, z);
}

// ----------- SETUP --------------------
void setup() {
  Wire.begin();
  pca1.begin();
  pca1.setPWMFreq(SERVO_FREQ);

  delay(1000);
}

// -------------LOOP
void loop() {
  for (float t = 0; t <= 1.0; t += 0.03) {
    legPath(leg1, t);      // picior 1
    legPath(leg2, t);      // picior 2 (sincron cu 1)
    legPath(leg3, 1 - t);  // picior 3 (opus pentru a reda imaginea unei miscari naturale de picioare)

    delay(25);
  }
}







